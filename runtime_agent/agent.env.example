# Copy to C:\OpenAS2\agent\agent.env on the Windows host (install script does this).
# Do NOT commit agent.env — it contains the live bearer token.
#
# Required:
OPENAS2_AGENT_TOKEN=change-me-to-a-long-random-token

# Optional overrides (install / run_agent_for_service.ps1 set sensible defaults):
# OPENAS2_ROOT=C:\OpenAS2
# OPENAS2_AGENT_HOST=0.0.0.0
# OPENAS2_AGENT_PORT=9475
# OPENAS2_PYTHON=C:\Path\To\python.exe
